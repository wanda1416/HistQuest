# 服务端口
PORT=3000

# 服务端模型凭据（M2 多人模式使用；M1 单人走 BYOK，可留空）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=6000

# 取证来源：local | wikipedia | off
WIKI_PROVIDER=local

# 单人默认提问次数
SOLO_TURNS=20

# 管理后台：留空则只允许本机访问；填了令牌后其他机器需带 Authorization: Bearer <token>
ADMIN_TOKEN=

# 后台保存前备份的保留份数（data/backups/）
ADMIN_BACKUP_KEEP=20

# 账号：会话签名密钥（留空时自动生成并存库，重启不掉登录）
SESSION_SECRET=
# 预置管理员（留空时库里第一个注册的账号成为管理员）
ADMIN_USER=
ADMIN_PASSWORD=
# 站方 Key 每日默认提问上限（单账号可在后台覆盖：-1 跟随默认，0 禁用）
DAILY_QUOTA=500